#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  q)
    # O -> Alt+Left -> I -> Shift+X
    ydotool key -d 40 \
      24:1 24:0 \
      56:1 105:1 105:0 56:0 \
      23:1 23:0 \
      42:1 45:1 45:0 42:0
    ;;
  w)
    # I -> Alt+Right -> O -> Shift+X
    ydotool key -d 40 \
      23:1 23:0 \
      56:1 106:1 106:0 56:0 \
      24:1 24:0 \
      42:1 45:1 45:0 42:0
    ;;
  *)
    echo "Usage: ${0##*/} {q|w}" >&2
    exit 2
    ;;
esac
